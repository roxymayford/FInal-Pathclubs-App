APP_NAME="Learning Path"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://your-laravel-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ─── SUPABASE POSTGRESQL CONFIGURATION ────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-2.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.<project_ref>
DB_PASSWORD=<your_supabase_db_password>
DB_SSLMODE=require
DB_URL=postgresql://postgres.<project_ref>:<your_supabase_db_password>@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
